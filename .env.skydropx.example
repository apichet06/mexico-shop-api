# Keep true until sandbox credentials are available. Mock mode never buys a label.
# ใช้ true ระหว่างที่ยังไม่มี Sandbox credentials เพื่อทดสอบโดยไม่ซื้อ label จริง
SKYDROPX_MOCK=true
# เลือกสภาพแวดล้อม sandbox หรือ production
SKYDROPX_MODE=sandbox
# URL ของ Skydropx API สำหรับสภาพแวดล้อมที่เลือก
SKYDROPX_BASE_URL=https://sb-pro.skydropx.com
# Client ID และ Client Secret จากเมนู Connections > API ของ Skydropx
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=

# ราคาที่แสดงและเรียกเก็บมาจาก quotation ของ Skydropx โดยตรง ไม่มีตารางราคาโซนหรือค่าบวกเพิ่มในระบบ
# รูปแบบ label: thermal สำหรับเครื่องพิมพ์ใบปะหน้า หรือ standard ตามที่ Skydropx รองรับ
SKYDROPX_PRINTING_FORMAT=thermal
# จำนวนครั้งสูงสุดที่ระบบตรวจผลราคา เพราะ Skydropx อาจคำนวณราคาแบบทยอยส่งผลกลับมา
SKYDROPX_QUOTE_POLL_ATTEMPTS=4
# เปิดการตรวจสอบสถานะพัสดุจาก Skydropx เมื่ออ่านข้อมูล order
SKYDROPX_TRACKING_SYNC_ON_READ=true
# เปิดการตรวจสอบสถานะพัสดุเมื่อโหลดรายการคำสั่งซื้อ (อาจเพิ่มจำนวน API calls)
SKYDROPX_TRACKING_SYNC_ON_LIST=false
# อีเมลสำรองของผู้ส่ง กรณีข้อมูลร้านไม่มีอีเมล
SKYDROPX_DEFAULT_EMAIL=

# Configure this same secret in Skydropx: Connections > Webhooks > Bearer token.
# ตั้งค่า secret เดียวกันใน Skydropx เมนู Connections > Webhooks สำหรับตรวจสอบว่า webhook มาจาก Skydropx จริง
SKYDROPX_WEBHOOK_TOKEN=
# URL ของ API ร้านค้าที่ Skydropx จะส่งสถานะพัสดุเข้ามา ต้องเป็น HTTPS เมื่อใช้งานจริง
SKYDROPX_WEBHOOK_URL=https://api.example.com/api/webhooks/skydropx
